# Bob Inference API key (server only — never use a VITE_ prefix for secrets)
AGENT_API_KEY=
# OpenAI-compatible base URL; server POSTs to ${AGENT_BASE_URL}/chat/completions
AGENT_BASE_URL=
# Authorization scheme sent as "authorization: <scheme> <key>" (use Bearer for other providers)
AGENT_AUTH_SCHEME=
# The model id
AGENT_MODEL=
# Optional JSON object of extra request headers
AGENT_HEADERS=
# The name shown on the Bob badge
AGENT_LABEL=
