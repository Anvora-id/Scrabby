# Bob Inference API key (server only — never use a VITE_ prefix for secrets)
AGENT_API_KEY=
# OpenAI-compatible base URL; server POSTs to ${AGENT_BASE_URL}/chat/completions
AGENT_BASE_URL=
# Authorization scheme sent as "authorization: <scheme> <key>" (use Bearer for other providers)
AGENT_AUTH_SCHEME=
# The model id
AGENT_MODEL=
# Optional JSON object of extra request headers
AGENT_HEADERS=
# The name shown on the Bob badge
AGENT_LABEL=
# "off" turns the usage limits off (local dev only)
AGENT_LIMITS=
# Fallback model key (Gemini); setting it turns the fallback on when Bob fails. Server only
FALLBACK_API_KEY=
# Fallback OpenAI-compatible base URL (default https://generativelanguage.googleapis.com/v1beta/openai)
FALLBACK_BASE_URL=
# Fallback authorization scheme (default Bearer)
FALLBACK_AUTH_SCHEME=
# Fallback model id (default gemini-3.8-flash)
FALLBACK_MODEL=
# Optional JSON object of extra request headers for the fallback
FALLBACK_HEADERS=
# The name on the Bob badge while the fallback runs (default Gemini)
FALLBACK_LABEL=
# App build: the Preview's origin. Leave empty locally (uses :5174). On Vercel: https://scrabby-preview.vercel.app
VITE_PREVIEW_ORIGIN=
# Preview build: the app's origin. Leave empty locally (uses :5173). On Vercel: https://scrabby-two.vercel.app
VITE_APP_ORIGIN=
# Agent's Reasoning Effort
AGENT_REASONING_EFFORT=